LLM_MODEL_ID=qwen3.5-plus
LLM_TIMEOUT_SECONDS=60
# Optional for compatible models such as Qwen; leave unset for other providers.
# LLM_ENABLE_THINKING=false
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j
NEO4J_DATABASE=neo4j

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=food_knowledge
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=COSINE

EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1024

KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_TOP_K=4
RERANK_MODEL=qwen3-vl-rerank
RERANK_API_KEY=
RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_TOP_N=12
RERANK_TIMEOUT_SECONDS=10

POSTGRES_DSN=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ricegod
POSTGRES_USER=ricegod
POSTGRES_PASSWORD=change_me_postgres

# Used by the Milvus object-store dependency in docker-compose.yml.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio

# Conversation State uses the same PostgreSQL database. Use memory only for disposable demos.
CHECKPOINT_BACKEND=postgres

MEMORY_TOP_K=5
MEMORY_RECENT_MESSAGES=8
MEMORY_SIMILARITY_THRESHOLD=0.9
MEMORY_RECONCILE_TOP_K=5
RECENT_CONTEXT_MESSAGES=8
# Full history is persisted; these limits apply only to model inputs.
# Budgets use conservative UTF-8 byte estimates, not provider token counts.
CONTEXT_RECENT_TURNS=6
CONTEXT_ROUTER_TOKEN_BUDGET=8000
CONTEXT_PLANNER_TOKEN_BUDGET=16000
CONTEXT_ANSWER_TOKEN_BUDGET=32000

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ricegod-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
